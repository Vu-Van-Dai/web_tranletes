# Non-secret values for the local docker-compose smoke test only (never used in production).
# Runs the container exactly like production (ASPNETCORE_ENVIRONMENT=Production, PACKAGE_STORE=r2)
# against a local S3-compatible server standing in for Cloudflare R2.
JWT_SECRET=smoke-test-only-jwt-secret-0123456789-abcdefghij
SEED_ADMIN_EMAIL=admin@smoke.test
SEED_ADMIN_USERNAME=smoke_admin
SEED_ADMIN_PASSWORD=Smoke-Admin-Password-123
PACKAGE_STORE=r2
R2_ENDPOINT=http://host.docker.internal:9100
R2_ACCESS_KEY=s3testadmin
R2_SECRET_KEY=s3testsecret123
R2_BUCKET=comicplatform-smoke
PUBLIC_IMAGE_URL=https://img.example.test
CORS_ALLOWED_ORIGINS=https://app.example.test
ORIGIN_SHARED_SECRET=smoke-origin-secret-0123456789
MIN_FREE_SPACE=10MB
