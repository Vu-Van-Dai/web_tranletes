<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CA1848/CA1873: LoggerMessage delegates are overkill here; CA2007: no SynchronizationContext in ASP.NET Core -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1716;CA1711;CA1062;CA1031;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA2201;CA1819;CA1056;CA1054;CA1055;CA2234;CA1002;CA2227;CA1515;CA1812;CA1822;CA5394;CA1725;CA1724;CA1034;CA1063;CA1816;CA2000;CA1508;CA1001</NoWarn>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
