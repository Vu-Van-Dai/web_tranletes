# ------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# Sizes accept plain bytes or KB/MB/GB suffixes.
# ------------------------------------------------------------------

# --- Database ---
DATABASE_CONNECTION_STRING=

# --- Auth ---
JWT_SECRET=
JWT_ISSUER=comicplatform
JWT_AUDIENCE=comicplatform-web
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=14

# --- First SystemAdmin (created at startup if none exists) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# --- Object storage (r2 | local) ---
PACKAGE_STORE=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Worker -> Oracle fallback shared secret
ORIGIN_SHARED_SECRET=

# Optional: purge edge cache on unpublish
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# --- Block volume ---
COMIC_STORAGE_PATH=/data/comics
TEMP_STORAGE_PATH=/data/tmp

# --- Limits ---
MAX_UPLOAD_SIZE=200MB
MAX_EXTRACTED_SIZE=600MB
MAX_PAGES_PER_CHAPTER=200
MAX_IMAGE_PIXELS=40000000
PAGE_MAX_WIDTH=2000
WEBP_QUALITY=82

# --- Processing ---
IMAGE_PROCESSING_CONCURRENCY=2
PROCESSING_QUEUE_CAPACITY=50
PROCESSING_JOB_TIMEOUT=00:15:00

# --- Web ---
ASPNETCORE_ENVIRONMENT=Production
CORS_ALLOWED_ORIGINS=
TRUST_CLOUDFLARE_HEADERS=false

# --- Public URLs (PUBLIC_* values are exposed to the browser build) ---
PUBLIC_APP_NAME=Rồng Nhỏ
PUBLIC_API_URL=
PUBLIC_IMAGE_URL=
